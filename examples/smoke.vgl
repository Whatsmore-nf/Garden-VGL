// VGL v2.0 冒烟测试 — 覆盖主要语言特性
canvas 800x600
seed 42

// 变量、数组、颜色
let cols = ["#ff6b6b", "#4ecdc4", "#ffe66e", "#95e1d3"]
let bg = linear_gradient([color(30, 20, 60), color(255, 180, 100)])
background(bg)

// 基本形状 + 命名参数
rect(50, 50, 120, 80, fill: "#ff6b6b", rx: 10, opacity: 0.9)
circle(200, 200, 40, fill: cols[1])
ellipse(320, 200, 50, 25, stroke: "#ffe66e", stroke_width: 3)
line(50, 300, 400, 300, stroke: "#ffffff", width: 2, cap: "round")
polygon([500, 50, 600, 150, 400, 150], fill: "#95e1d3", opacity: 0.8)
polyline([650, 50, 700, 120, 760, 60, 780, 150], stroke: "#ff6b6b", width: 4, join: "round")

// 文本（真 SVG 文本）
text(400, 380, "VGL v2.0 — Hello Vector", size: 28, fill: "#ffffff", anchor: "middle", weight: "bold")

// 渐变 + 路径
let glow = radial_gradient([color(255, 220, 150), color(255, 180, 100, 0.4), color(255, 180, 100, 0)])
circle(650, 420, 60, fill: glow)

// 函数 + 循环 + 噪声
fn dot_row(y, n = 10) {
    for i in 0..n {
        let x = 60 + i * 70
        let r = 8 + fbm(i * 0.3, y * 0.01) * 6
        circle(x, y, r, fill: cols[i % 4], opacity: 0.7)
    }
}
dot_row(450)
dot_row(520, 8)

// group 变换
group(translate: [400, 560], rotate: 15) {
    rect(-40, -15, 80, 30, fill: "#4ecdc4", rx: 6)
    text(0, 6, "group", size: 14, fill: "#1a1a2e", anchor: "middle")
}

// smooth 平滑路径
let wave = []
for i in 0..20 {
    push(wave, 60 + i * 36)
    push(wave, 590 + sin(i * 0.8) * 8)
}
path(smooth(wave), stroke: "#ffffff", width: 2, fill: none, opacity: 0.6)

render "smoke.svg"
