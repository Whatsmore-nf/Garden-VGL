// ============================================================
// terrain.vgl — 语义化地形矢量库
// 山脊 / 层叠远山 / 沙丘 / 雪线
// 用法: use "lib/terrain.vgl"
// 山形由 fbm 噪声驱动，输出平滑多边形，可无限缩放
// ============================================================

// 单条山脊：fbm 起伏折线闭合到底部
// off: 噪声偏移（不同 off 生成不同山形）
fn ridge(y_base, amp = 70, freq = 0.006, col = color(70, 60, 95), off = 0, octaves = 4) {
    let w = width()
    let h = height()
    let pts = []
    for x in 0..w + 20 step 14 {
        let n = fbm(x * freq + off, off * 0.7, octaves)
        push(pts, x)
        push(pts, y_base + n * amp)
    }
    // 闭合到画布底部
    push(pts, w + 20)
    push(pts, h + 4)
    push(pts, -20)
    push(pts, h + 4)
    polygon(pts, fill: col, stroke: none)
    // 山脊亮边（受光）
    let ridge_pts = []
    for x in 0..w + 20 step 14 {
        let n = fbm(x * freq + off, off * 0.7, octaves)
        push(ridge_pts, x)
        push(ridge_pts, y_base + n * amp)
    }
    path(smooth(ridge_pts), stroke: lighten(col, 0.3), width: 1.5, opacity: 0.6)
}

// 层叠远山：多条山脊由浅入深，营造大气透视
fn mountains(layers = 4, y_base = height() * 0.62, far = color(150, 140, 175), near = color(35, 28, 55), amp = 80) {
    let n = max(layers, 2)
    for i in 0..n {
        let t = i / (n - 1)
        let col = lerp_color(far, near, t)
        let y = y_base - amp * 0.9 + t * amp * 0.75
        ridge(y, amp * (0.5 + t * 0.5), 0.005 + t * 0.003, col, 100 + i * 37.7, 4)
    }
}

// 雪线：在山脊上方叠一条白色覆盖
fn snow_cap(y_base, amp = 70, freq = 0.006, col = color(245, 248, 255), off = 0, depth = 26, octaves = 4) {
    let w = width()
    let pts = []
    for x in 0..w + 20 step 14 {
        let n = fbm(x * freq + off, off * 0.7, octaves)
        let ny = y_base + n * amp
        // 雪面下缘参差
        let drift = fbm(x * 0.02 + off, 55.5, 2) * 8
        push(pts, x)
        push(pts, ny + depth + drift)
    }
    // 闭合回山脊表面（沿脊线上方）
    let back = []
    for x in 0..w + 20 step 14 {
        let n = fbm((w + 20 - x) * freq + off, off * 0.7, octaves)
        push(back, w + 20 - x)
        push(back, y_base + n * amp - 2)
    }
    let all = []
    for i in 0..len(pts) {
        push(all, pts[i])
    }
    for i in 0..len(back) {
        push(all, back[i])
    }
    polygon(all, fill: col, stroke: none, opacity: 0.95)
}

// 沙丘：低频正弦 + 噪声的柔和起伏
fn dunes(y_base, amp = 40, col = color(222, 184, 130), off = 0) {
    let w = width()
    let h = height()
    let pts = []
    for x in 0..w + 20 step 18 {
        let dune = sin(x * 0.004 + off) * 0.6 + fbm(x * 0.003 + off, 7.7, 2) * 0.4
        push(pts, x)
        push(pts, y_base + dune * amp)
    }
    push(pts, w + 20)
    push(pts, h + 4)
    push(pts, -20)
    push(pts, h + 4)
    polygon(pts, fill: col, stroke: none)
    // 背光面阴影
    let shade = []
    for x in 0..w + 20 step 18 {
        let dune = sin(x * 0.004 + off) * 0.6 + fbm(x * 0.003 + off, 7.7, 2) * 0.4
        push(shade, x)
        push(shade, y_base + dune * amp + 10)
    }
    path(smooth(shade), stroke: darken(col, 0.25), width: 5, opacity: 0.5, blur: 3)
}
