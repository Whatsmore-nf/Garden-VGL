// ============================================================
// water.vgl — 语义化水面矢量库
// 水面渐变 / 波纹 / 光带倒影
// 用法: use "lib/water.vgl"
// ============================================================

// 水面主体：垂直渐变（近岸亮 → 深处暗）
fn water(y = height() * 0.66, col_top = color(120, 180, 210), col_deep = color(20, 50, 90)) {
    let h = height()
    let grad = linear_gradient([col_top, col_deep], y1: y, y2: h)
    rect(0, y, width(), h - y, fill: grad, stroke: none)
}

// 波纹：若干条正弦 + 噪声调制的平滑波线
fn waves(y, rows = 5, span = 60, amp = 5, col = color(235, 245, 252)) {
    let w = width()
    for r in 0..rows {
        let wy = y + 18 + r * (span / rows)
        let seg = 40 + r * 10
        let pts = []
        for x in 0..w + seg step seg {
            let wob = sin(x * 0.02 + r * 1.7) * amp + fbm(x * 0.01, r * 3.1, 2) * amp * 0.8
            push(pts, x)
            push(pts, wy + wob)
        }
        // 越往远处波纹越淡
        let fade = 1.0 - r / (rows + 2)
        path(smooth(pts), stroke: col, width: 1.4, opacity: 0.5 * fade)
    }
}

// 光带倒影：日月灯光在水面拉出的竖向渐变光柱
fn shimmer(x, y, w = 90, col = color(255, 230, 170)) {
    let h = height()
    let grad = linear_gradient([alpha(col, 0.75), alpha(col, 0.2), alpha(col, 0)], y1: y, y2: h)
    // 光柱下端张开（梯形）
    polygon([x - w * 0.32, y, x + w * 0.32, y, x + w * 0.5, h, x - w * 0.5, h], fill: grad, stroke: none, blur: 4)
    // 亮斑碎片
    for i in 0..7 {
        let sy = y + 12 + i * (h - y) / 8
        let sw = w * (0.2 + rand(0, 0.35))
        rect(x - sw / 2 + rand(-w * 0.2, w * 0.2), sy, sw, 2.5, fill: col, opacity: 0.45 - i * 0.05, rx: 1.2)
    }
}
