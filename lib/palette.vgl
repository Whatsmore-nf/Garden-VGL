// ============================================================
// palette.vgl — 语义调色板库
// 按时刻 / 情绪命名的配色，返回颜色数组
// 用法: use "lib/palette.vgl"
//   let cols = palette("dusk")
//   sky(cols[0], cols[1])
// ============================================================

// 取一套调色板（数组：天空顶 → 天空底 → 主光 → 点缀）
fn palette(name = "dawn") {
    if name == "dawn" {
        return [color(34, 24, 64), color(255, 170, 110), color(255, 214, 145), color(255, 120, 120)]
    }
    if name == "noon" {
        return [color(68, 132, 205), color(168, 214, 240), color(255, 244, 200), color(80, 170, 100)]
    }
    if name == "dusk" {
        return [color(24, 18, 48), color(214, 92, 92), color(255, 168, 96), color(120, 80, 160)]
    }
    if name == "night" {
        return [color(8, 10, 26), color(28, 34, 72), color(200, 210, 255), color(120, 200, 180)]
    }
    if name == "forest" {
        return [color(120, 180, 190), color(210, 232, 210), color(80, 150, 90), color(50, 100, 70)]
    }
    if name == "ocean" {
        return [color(30, 60, 110), color(90, 160, 190), color(230, 245, 250), color(40, 90, 140)]
    }
    if name == "pastel" {
        return [color(255, 209, 220), color(255, 236, 210), color(173, 216, 230), color(200, 180, 220)]
    }
    if name == "mono" {
        return [color(24, 24, 28), color(70, 70, 80), color(160, 160, 170), color(235, 235, 240)]
    }
    return [color(34, 24, 64), color(255, 170, 110), color(255, 214, 145), color(255, 120, 120)]
}

// 取调色板前两色做成天空垂直渐变
fn palette_sky(name = "dawn") {
    let cols = palette(name)
    return linear_gradient([cols[0], cols[1]])
}

// 环形取色：i 超界自动回绕
fn palette_pick(cols, i) {
    let n = len(cols)
    let j = i % n
    if j < 0 {
        return cols[j + n]
    }
    return cols[j]
}
