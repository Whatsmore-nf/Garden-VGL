// ============================================================
// vegetation.vgl — 语义化植被矢量库
// 阔叶树 / 针叶树 / 森林 / 草丛
// 用法: use "lib/vegetation.vgl"
// ============================================================

// 阔叶树：树干 + 三团圆冠（径向渐变受光）
fn broadleaf(x, ground, s = 40, leaf = color(56, 130, 60), trunk = color(92, 64, 46)) {
    rect(x - s * 0.06, ground - s * 0.62, s * 0.12, s * 0.64, fill: trunk, stroke: none, rx: s * 0.04)
    // 主枝
    line(x, ground - s * 0.5, x - s * 0.22, ground - s * 0.72, stroke: trunk, width: s * 0.07, cap: "round")
    line(x, ground - s * 0.55, x + s * 0.2, ground - s * 0.8, stroke: trunk, width: s * 0.07, cap: "round")
    // 冠层：三团圆，左暗右亮
    let dark = darken(leaf, 0.22)
    let lite = lighten(leaf, 0.22)
    circle(x - s * 0.3, ground - s * 0.82, s * 0.3, fill: dark)
    circle(x + s * 0.3, ground - s * 0.85, s * 0.32, fill: leaf)
    let crown = radial_gradient([lite, leaf], cx: x + s * 0.12, cy: ground - s * 1.02, r: s * 0.48)
    circle(x + s * 0.05, ground - s * 1.0, s * 0.42, fill: crown)
}

// 针叶树：树干 + 三层三角形
fn conifer(x, ground, s = 40, leaf = color(38, 92, 58), trunk = color(80, 56, 40)) {
    rect(x - s * 0.05, ground - s * 0.3, s * 0.1, s * 0.32, fill: trunk, stroke: none)
    let dark = darken(leaf, 0.2)
    polygon([x, ground - s * 1.05, x - s * 0.22, ground - s * 0.62, x + s * 0.22, ground - s * 0.62], fill: leaf)
    polygon([x, ground - s * 0.85, x - s * 0.3, ground - s * 0.36, x + s * 0.3, ground - s * 0.36], fill: dark)
    polygon([x, ground - s * 0.62, x - s * 0.38, ground - s * 0.12, x + s * 0.38, ground - s * 0.12], fill: leaf)
}

// 单棵树入口：kind 0 阔叶，kind 1 针叶
fn tree(x, ground, s = 40, kind = 0, leaf = color(56, 130, 60), trunk = color(92, 64, 46)) {
    if kind == 1 {
        conifer(x, ground, s, leaf, trunk)
    } else {
        broadleaf(x, ground, s, leaf, trunk)
    }
}

// 森林：远小近大、远淡近深，按 y 从远到近绘制保证遮挡正确
// kind: 0 阔叶 / 1 针叶 / 2 混交
fn forest(count = 20, y_min = height() * 0.68, y_max = height() * 0.92, kind = 2, leaf = color(56, 130, 60)) {
    for i in 0..count {
        let t = i / count
        let y = y_min + t * (y_max - y_min)
        let x = rand(0, width())
        let s = 22 + t * 44
        let shade = lerp_color(lighten(leaf, 0.3), darken(leaf, 0.15), t)
        if kind == 2 {
            tree(x, y, s, rand_int(0, 1), shade)
        } else {
            tree(x, y, s, kind, shade)
        }
    }
}

// 草丛：地面一排轻摆的短弧线
fn grass(y, count = 40, col = color(90, 150, 80), len = 12) {
    let w = width()
    for i in 0..count {
        let gx = rand(0, w)
        let gl = len * rand(0.6, 1.3)
        let lean = rand(-4, 4)
        let pts = [gx, y, gx + lean * 0.4, y - gl * 0.6, gx + lean, y - gl]
        path(smooth(pts), stroke: col, width: 1.6, cap: "round", opacity: 0.85)
    }
}
