// ============================================================
// atmosphere.vgl — 语义化大气效果矢量库
// 雾 / 雨 / 雪 / 光柱 / 暗角 / 色调罩
// 用法: use "lib/atmosphere.vgl"
// ============================================================

// 雾带：垂直渐变 + 模糊的横带（上透明 → 中浓 → 下透明）
fn fog(y, h_band = 90, col = color(205, 214, 224), density = 0.5) {
    let w = width()
    let grad = linear_gradient([alpha(col, 0), alpha(col, density), alpha(col, 0)], y1: y, y2: y + h_band)
    rect(-20, y, w + 40, h_band, fill: grad, stroke: none, blur: 6)
}

// 地面雾：贴地弥散的一层
fn ground_fog(y, col = color(210, 218, 228), density = 0.4) {
    let h = height()
    let w = width()
    let grad = linear_gradient([alpha(col, 0), alpha(col, density)], y1: y - 40, y2: h)
    rect(-20, y - 40, w + 40, h - y + 44, fill: grad, stroke: none, blur: 8)
}

// 雨：斜线雨丝（近粗远细分两层）
fn rain(count = 130, slant = 0.28, col = color(178, 198, 220)) {
    let w = width()
    let h = height()
    // 远景细雨
    group(opacity: 0.4) {
        for i in 0..count / 2 {
            let x = rand(0, w)
            let y = rand(0, h)
            let len = rand(12, 22)
            line(x, y, x + slant * len, y + len, stroke: col, width: 1)
        }
    }
    // 近景雨丝
    for i in 0..count / 2 {
        let x = rand(0, w)
        let y = rand(0, h)
        let len = rand(20, 34)
        line(x, y, x + slant * len, y + len, stroke: col, width: 1.6, opacity: 0.65)
    }
}

// 雪：三层雪花（远小模糊、近大清晰），缓慢飘落感
fn snow(count = 90, col = color(245, 248, 255)) {
    let w = width()
    let h = height()
    group(blur: 1.5, opacity: 0.5) {
        for i in 0..count / 3 {
            circle(rand(0, w), rand(0, h), rand(0.8, 1.4), fill: col)
        }
    }
    for i in 0..count / 3 {
        circle(rand(0, w), rand(0, h), rand(1.6, 2.4), fill: col, opacity: 0.85)
    }
    for i in 0..count / 3 {
        let r = rand(2.6, 3.8)
        circle(rand(0, w), rand(0, h), r, fill: col)
    }
}

// 丁达尔光柱：自光源向下的扇形光束
fn light_rays(x, y, n = 6, len = 340, col = color(255, 240, 200), spread = 55, intensity = 0.5) {
    group(translate: [x, y], blur: 7, opacity: intensity) {
        for j in 0..n {
            let a = (j / (n - 1) - 0.5) * spread * 3.14159 / 180
            let hw = 0.022 + rand(0, 0.02)
            let l = len * rand(0.7, 1.1)
            let dx = sin(a) * l
            let dy = cos(a) * l
            let px = cos(a) * hw * l
            let py = -sin(a) * hw * l
            let beam = linear_gradient([alpha(col, 0.85), alpha(col, 0)], x1: 0, y1: 0, x2: dx, y2: dy)
            polygon([0, 0, dx + px, dy + py, dx - px, dy - py], fill: beam, stroke: none)
        }
    }
}

// 暗角：四周压暗，聚焦画面中心
fn vignette(strength = 0.45, col = color(10, 8, 22)) {
    let w = width()
    let h = height()
    let r = max(w, h) * 0.72
    let grad = radial_gradient([alpha(col, 0), alpha(col, 0), alpha(col, strength)], cx: w / 2, cy: h / 2, r: r)
    rect(0, 0, w, h, fill: grad, stroke: none)
}

// 色调罩：整幅画面统一调色（如暖化 / 冷化）
fn tint(col = color(255, 180, 100), strength = 0.12) {
    rect(0, 0, width(), height(), fill: alpha(col, strength), stroke: none)
}
